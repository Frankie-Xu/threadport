{
  "name": "threadport",
  "version": "0.1.0",
  "description": "Portable, verifiable work state for coding agents.",
  "author": "Frankie-Xu",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "threadport": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./storage": {
      "types": "./dist/src/storage/sqlite-store.d.ts",
      "import": "./dist/src/storage/sqlite-store.js"
    },
    "./sources": {
      "types": "./dist/src/sources/registry.d.ts",
      "import": "./dist/src/sources/registry.js"
    },
    "./indexing": {
      "types": "./dist/src/indexing/service.d.ts",
      "import": "./dist/src/indexing/service.js"
    }
  },
  "files": [
    "dist/src",
    "schema",
    "examples",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:pack": "node scripts/pack-smoke.mjs",
    "test": "vitest run",
    "check": "npm run typecheck && npm run build && npm test && npm run check:docs",
    "check:docs": "node scripts/check-doc-links.mjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "marked": "15.0.12",
    "typescript": "^5.9.0",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
