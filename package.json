{
  "name": "threadport",
  "version": "0.1.0",
  "description": "Portable, verifiable work state for coding agents.",
  "author": "Frankie-Xu",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "threadport": "./dist/src/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "schema",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "check": "npm run build && npm test"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
